{
  "name": "bible-questions-app",
  "version": "1.0.8",
  "description": "A private, fully offline Bible learning desktop application",
  "author": "Bible Questions App Project",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "kill-port 5173 && wait-on --reverse tcp:5173 && tsc -p tsconfig.electron.json && concurrently -k \"vite --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/launch-electron.cjs\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron-builder": "latest",
    "electron": "37.4.0",
    "kill-port": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "org.selahbible.desktop",
    "productName": "Bible Questions App",
    "publish": [
      {
        "provider": "github",
        "owner": "cfanfelle",
        "repo": "Bible-Questions-App",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "content",
        "to": "content",
        "filter": [
          "*.txt",
          "LICENSES.md"
        ]
      }
    ],
    "win": {
      "artifactName": "Bible-Questions-App-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.education",
      "artifactName": "Bible-Questions-App-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
